{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build WoW Addon - Arcane Wizard: Library",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\..\\build-tools\\local-build\\build-addon.ps1",
        "-ProjectRoot",
        "${workspaceFolder}",
        "-SelectLibraryPreview"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Build WoW Addon - Arcane Wizard: Library (Ohne Vorschau)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\..\\build-tools\\local-build\\build-addon.ps1",
        "-ProjectRoot",
        "${workspaceFolder}",
        "-LibraryPreview",
        "0"
      ],
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    }
  ]
}
